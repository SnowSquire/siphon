      }
    },
    {
      "name": "Debug unit tests in library 'wait_on_address'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--package=wait_on_address"]
      }
    },
    {
      "name": "Debug integration test 'test'",
      "type": "lldb",
      "request": "launch",
      "cargo": {

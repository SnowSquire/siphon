{
  "include": ["**/*.js", "**/*.ts", "src/server.ts.nvm", "output/129721.ts"],
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "module": "ESNext",
    "lib": ["esnext", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "ESNext.Iterator"],
    "types": ["node"],
    "checkJs": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}

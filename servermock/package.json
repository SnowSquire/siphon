{
  "name": "servermock",
  "version": "1.0.0",
  "description": "Mock Twitch HLS edge server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch main.ts",
    "build:fixtures": "node build-fixtures.ts",
    "build:notifier": "cargo build --release --manifest-path notifier-rs/Cargo.toml && node -e \"require('node:fs').copyFileSync('notifier-rs/target/release/notifier_rs.dll', 'notifier-rs/notifier_rs.node')\""
  },
  "dependencies": {
    "@node-rs/xxhash": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}